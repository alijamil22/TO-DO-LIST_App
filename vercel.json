{
  "version": 2,
  "builds": [
    {
      "src": "ToDo_Project/ToDo_Project/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "ToDo_Project/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "ToDo_Project/ToDo_Project/wsgi.py"
    }
  ]
}
